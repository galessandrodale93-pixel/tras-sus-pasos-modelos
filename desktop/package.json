{
  "name": "kids-and-hero",
  "productName": "Kids & Hero",
  "version": "1.2.0",
  "description": "Kids and Hero - Habitat CFM",
  "author": "Habitat CFM",
  "homepage": "https://www.habitat-cfm.org/kids-hero.html",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@electron/fuses": "^1.8.0"
  },
  "build": {
    "appId": "org.habitat-cfm.kidshero",
    "productName": "Kids & Hero",
    "copyright": "Habitat CFM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "cache.js",
      "preload.js",
      "descarga.html",
      "build/icon.png",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kids-and-Hero-Windows.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "Kids-and-Hero-Mac.${ext}",
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "Kids & Hero",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 230,
          "type": "file"
        },
        {
          "x": 400,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "despues-de-armar.js",
    "asar": true,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kids & Hero",
      "uninstallDisplayName": "Kids & Hero",
      "artifactName": "Kids-and-Hero-Windows.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "es_ES",
        "en_US",
        "pt_BR"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/galessandrodale93-pixel/tras-sus-pasos-modelos/releases/download/escritorio"
      }
    ],
    "appx": {
      "applicationId": "KidsAndHero",
      "displayName": "Kids & Hero",
      "identityName": "HabitatCFM.KidsHero",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Habitat CFM",
      "backgroundColor": "#130f18",
      "languages": [
        "es-AR",
        "es-ES",
        "en-US",
        "pt-BR"
      ],
      "showNameOnTiles": false,
      "artifactName": "Kids-and-Hero-Store.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
