{
  "name": "kids-and-hero",
  "productName": "Kids & Hero",
  "version": "1.2.0",
  "description": "Kids & Hero · Habitat CFM",
  "author": "Habitat CFM",
  "homepage": "https://www.habitat-cfm.org/kids-hero.html",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win squirrel portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "^25.1.8"
  },
  "build": {
    "appId": "org.habitat-cfm.kidshero",
    "productName": "Kids & Hero",
    "copyright": "Habitat CFM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "cache.js",
      "preload.js",
      "descarga.html",
      "build/icon.png",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "squirrel",
        "portable"
      ],
      "artifactName": "Kids-and-Hero-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Kids-and-Hero-Portable-${version}.${ext}"
    },
    "squirrelWindows": {
      "name": "KidsAndHero",
      "loadingGif": "build/instalando.gif",
      "iconUrl": "https://raw.githubusercontent.com/galessandrodale93-pixel/tras-sus-pasos-modelos/main/desktop/build/icon.ico",
      "artifactName": "Kids-and-Hero-Instalar-${version}.${ext}",
      "msi": false
    }
  }
}
