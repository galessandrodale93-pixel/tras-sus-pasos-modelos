{
  "name": "kids-and-hero",
  "productName": "Kids & Hero",
  "version": "1.2.0",
  "description": "Kids and Hero - Habitat CFM",
  "author": "Habitat CFM",
  "homepage": "https://www.habitat-cfm.org/kids-hero.html",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win squirrel --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "^25.1.8",
    "@electron/fuses": "^1.8.0"
  },
  "build": {
    "appId": "org.habitat-cfm.kidshero",
    "productName": "Kids & Hero",
    "copyright": "Habitat CFM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "cache.js",
      "preload.js",
      "descarga.html",
      "build/icon.png",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "squirrel"
      ],
      "artifactName": "Kids-and-Hero-${version}-${arch}.${ext}"
    },
    "squirrelWindows": {
      "name": "KidsAndHero",
      "loadingGif": "build/instalando.gif",
      "iconUrl": "https://raw.githubusercontent.com/galessandrodale93-pixel/tras-sus-pasos-modelos/main/desktop/build/icon.ico",
      "artifactName": "Kids-and-Hero-Windows.${ext}",
      "msi": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "Kids-and-Hero-Mac.${ext}",
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "Kids & Hero",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 230,
          "type": "file"
        },
        {
          "x": 400,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "despues-de-armar.js",
    "asar": true
  }
}
